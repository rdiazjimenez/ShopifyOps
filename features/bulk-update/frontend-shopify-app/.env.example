# Shopify Partners app credentials
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Shopify API scopes (comma-separated, no spaces)
SCOPES=read_products,write_products,read_inventory,write_inventory

# Full Vercel deployment URL (no trailing slash)
SHOPIFY_APP_URL=https://shopify-ops.vercel.app

# Neon Postgres connection string (set automatically by Vercel Postgres integration)
DATABASE_URL=

